// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  MEMBER
  ADMIN
  FACTORY
}

/** 지역 서브 관리자. ADMIN + null = Super admin */
enum AdminRegion {
  JUNGBU // 중부(덕소)
  NAMBU  // 남부(기장)
  SEOBU  // 서부(소사)
}

enum OrderStatus {
  PLACED
  WAITING_FOR_SHIPMENT
  PREPARED
  LOAD_NOTIFIED
  SHIPPING
  RECEIVED
  PRINTING_COMPLETE
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // bcrypt hash (cost 10)
  
  fullname  String
  phone     String
  
  email     String?

  role         Role          @default(MEMBER)
  adminRegion  AdminRegion?  // ADMIN일 때만 사용. null이면 Super admin
  /** Factory-G: 인사장완료 승인 가능 (username 01029647088) */
  canApproveGreeting Boolean @default(false)
  /** Incremented on each login; JWT `sv` must match or session is rejected. */
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]  // One-to-many relationship: A user can place many orders
  greetingForms GreetingForm[]
  adminActivities AdminActivity[]
  partners Partner[]

  // Relation to the Church model (Moved inside the block)
  churchId  Int?
  church    Church?  @relation(fields: [churchId], references: [id])
}

model Partner {
  id          Int      @id @default(autoincrement())
  name        String   // 거래처명
  contactName String   // 담당자명
  phone       String   // 연락처
  address     String   // 주소
  email       String?  // 이메일 (optional)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, name])
}

model Church {
  id          Int      @id @default(autoincrement())
  name        String   @unique // e.g., "서울5", "일동", "부산남"
  region      String   // e.g., "서울", "일동", "부산" (great for filtering)
  branchCode  String?  // e.g., "5", "남", or null for single churches
  assigner    String   // e.g., "이영심(총)", "공석"
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Order {
  id              Int          @id @default(autoincrement())
  orderNumber     String       @unique // E.g., "ORD-2026-000001"
  status          OrderStatus  @default(PLACED)
  totalAmount     Float        @default(0.0)
  notes           String?
  /** 제품주문서 특이사항 (출고·포장관리 표시) */
  extraNote       String?      @map("extra_note")
  /** 공장 화면 알림 (예: 주문서 변경요청발생!). 확인 후 null */
  factoryAlert    String?

  /** 주문 작업 매장 지역 (남부/중부/서부) */
  storeRegion     AdminRegion?
  /** 택배 작업 위치: 매장 | 공장 */
  packagingWorker PackagingWorker? @map("packaging_worker")

  orderConfirmedAt DateTime?
  orderConfirmedBy String?

  paymentDone   Boolean @default(false)
  paymentAuthor String?

  greetingDone Boolean @default(false)

  slipDone   Boolean @default(false)
  slipAuthor String?

  /** 작업자+확인+결제+인사장+기표지 충족 시 true → 배송/출고/포장 후보 */
  readyForShipment Boolean @default(false)

  /** 배송관리: 출고요청일 */
  requestedShipDate DateTime?
  /** 포장구분: 공장포장 | 양말부포장 */
  packDept PackDept?
  packDate DateTime?
  packPt String?
  storagePlace String?
  packDone Boolean @default(false)

  /** 출고관리: 출고완료 */
  releaseDone Boolean @default(false)
  releaseDoneAt DateTime?

  /** 배송관리: 최종완료 / 최종확인 */
  finalCompleteDone Boolean @default(false)
  finalConfirmDone Boolean @default(false)

  // Relations
  userId          Int
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  greetingForms   GreetingForm[]
  
  // One-to-One: Every order has exactly one shipment profile
  shipment        Shipment?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([storeRegion])
  @@index([readyForShipment])
  @@index([requestedShipDate])
  @@index([packDept])
}

/// 관리자 액션 알림 피드
model AdminActivity {
  id           Int                 @id @default(autoincrement())
  actorUserId  Int?
  actor        User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName    String
  actorRegion  AdminRegion?
  action       AdminActivityAction
  orderId      Int?
  orderNumber  String
  summary      String
  createdAt    DateTime            @default(now())

  @@index([createdAt])
  @@index([actorUserId])
}



// 2. New Shipment Model for Logistics Tracking
model Shipment {
  id              Int             @id @default(autoincrement())
  fulfillmentType FulfillmentType @default(PARCEL)
  
  // Fields for PARCEL (Truck delivery)
  carrier         String?         // E.g., "Sanc-Trucking-04", "FedEx"
  trackingNumber  String?         
  deliveryAddress String?         // Required if PARCEL
  estimatedWindow DateTime?       // Expected arrival date/time

  // Fields for PICKUP (Self-service)
  pickupLocation  String?         // Which warehouse/hub they are coming to
  pickupTimeSlot  DateTime?       // Scheduled time window for customer arrival
  licensePlate    String?         // Optional: Vehicle info for security verification
  
  // Tracking status specifically for the physical movement
  shippedAt       DateTime?
  deliveredAt     DateTime?       // Or pickedUpAt

  // Relation back to the Order
  orderId         Int             @unique
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}



model OrderItem {
  id          Int      @id @default(autoincrement())
  productName String
  quantity    Int      @default(1)
  price       Float

  // Relations
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum StockLedgerType {
  INITIAL
  ADDITION
  ORDER_DEDUCT
}

/// Product catalog for order "상품 추가" modal (Excel-sourced)
model StockInventory {
  id                Int      @id @default(autoincrement())
  code              String   @unique // 코드
  imageUrl          String? // Blob URL or /assets/products/gift_sets/...
  imageStoredName   String? // 날짜+random 저장 파일명
  imageOriginalName String? // 원본 파일명
  productName       String // 품명
  spec              String? // 규격
  unit              Int // 판매 단위
  stock             Int? // 창고 재고 수량 (null = 무제한)
  stockMax          Int? // 기준/최대 재고 (표시용 current/max, null이면 현재수량만 표시)
  effectiveDate     DateTime // 적용일자 (YYYYMMDD)
  priceOver500man   Float // 전체 500만원이상 주문시 할인가격
  priceOver100man   Float // 전체 100만원이상 주문시 할인가격
  wholesalePrice    Float // 도매 (기본적용가격)
  associatePrice    Float // 준회원
  category          String // 구분 (선물세트, 일반품)
  openStock         Boolean @default(true) @map("open_stock") // 고객 공개 여부
  boxName           String? @map("box_name") // 우체국 박스명 (예: 신앙촌 1호)
  postWeight        Int?    @map("post_weight") // 우체국 박스 무게 KG (예: 2, 5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgers StockInventoryLedger[]

  @@map("stock_inventory")
  @@index([category])
  @@index([productName])
  @@index([openStock])
}

/// 재고 변동 이력 (초기재고 / 추가재고 / 주문차감)
model StockInventoryLedger {
  id          Int             @id @default(autoincrement())
  productId   Int
  productName String
  type        StockLedgerType
  delta       Int // +추가 / -차감
  actorLabel  String // "자동(주문관리 연동)" | "공장 관리자"
  orderId     Int?
  createdAt   DateTime        @default(now())

  product StockInventory @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type])
  @@index([createdAt])
  @@map("stock_inventory_ledger")
}

/// 인사장 작성 폼 (제품주문 연계 / 인사장만 의뢰)
model GreetingForm {
  id                Int      @id @default(autoincrement())
  greetingNumber    String // 1~4
  includeSelf       Boolean  @default(false) // 자체
  imageUrl          String // Blob URL or /assets/greeting_form/...
  imageStoredName   String // 날짜+random 저장 파일명
  imageOriginalName String // 원본 파일명
  content           String // 인사장내용
  quantity          Int // 수량
  size              String // 8칸 | 6칸 | 4칸
  productName       String? // 제품주문 연계일 때만
  receivePlace      String // 받을 곳
  specialNote       String? // 특이사항
  businessCard      String  @default("선택하세요") @map("business_card") // 명함 유무: 선택하세요 | 동봉
  ordererName       String? // 성명(주문자)
  churchName        String? // 중앙
  phone             String? // 연락처
  linkedToOrder     Boolean // true = 제품주문 연계, false = 인사장만 의뢰
  submitted         Boolean  @default(false) // 인사장만 접수 완료 여부

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId  Int?
  user    User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("greeting_form")
  @@index([linkedToOrder])
  @@index([orderId])
  @@index([createdAt])
}

// 1. Define how the package gets to its destination
enum FulfillmentType {
  PARCEL   // Truck delivery by SANC
  PICKUP   // Customer picks up with their own vehicle to save fees
}

/** 택배 작업 위치: 매장 | 공장 */
enum PackagingWorker {
  STORE
  FACTORY
}

/** 포장관리: 공장포장 | 양말부포장 */
enum PackDept {
  FACTORY_PACK
  SOCK_PACK
}

enum AdminActivityAction {
  ORDER_CONFIRM
  WORKER_SAVE
  PAYMENT_SAVE
  GREETING_SAVE
  SLIP_SAVE
  SHIP_DATE_SAVE
  PACK_DEPT_SAVE
  PACK_COMPLETE
  RELEASE_COMPLETE
  FINAL_COMPLETE
  FINAL_CONFIRM
}


