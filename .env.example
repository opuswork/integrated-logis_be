# Copy to .env and fill in values. Never commit real secrets.

# Local Docker Postgres
# DATABASE_URL="postgresql://postgres:sanc_logistics@localhost:5434/sanc_logistics?schema=public"

# Render / hosted Postgres (external host + SSL from local machine)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_SECONDS=86400

# CORS — Vercel FE origin (no trailing slash)
FRONTEND_ORIGIN="https://YOUR-VERCEL-APP.vercel.app"

# Image uploads (required on Render)
BLOB_READ_WRITE_TOKEN=

# Solapi SMS (leave empty for dev — OTP logged to console)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=소비조합
